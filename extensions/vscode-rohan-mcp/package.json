    "Programming Languages",
    "Security"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zero-knowledge",
    "midnight-network",
    "ai-agents",
    "privacy",
    "copilot",
    "cline",
    "roo-code"
  ],
  "homepage": "https://rohanprotocol.network",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohan-protocol/rohan.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rohan.configureMcp",
