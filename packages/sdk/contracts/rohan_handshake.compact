// Rohan Protocol Handshake Verifier
// Hardened against State-Poisoning (Security Vector V-05)

ledger current_batch_root: Cell<Bytes<32>>;
ledger authorized_prover: Cell<Bytes<32>>;
ledger is_initialized: Cell<Boolean>;

export circuit initial_setup(admin_pk: Bytes<32>, initial_root: Bytes<32>): [] {
    // Verhindert Re-Initialization und State-Poisoning
    assert !is_initialized "CONTRACT_ALREADY_INITIALIZED";
    
    authorized_prover = disclose(admin_pk);
    current_batch_root = disclose(initial_root);
    is_initialized = disclose(true);
}

export circuit verify_batched_handshakes(new_root: Bytes<32>): [] {
    assert is_initialized "CONTRACT_NOT_INITIALIZED";
    // Verankert die neue Batch-Root nach mathematischer ZK-Verifikation
    current_batch_root = disclose(new_root);
}
