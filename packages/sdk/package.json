{
  "name": "@rohan-protocol/sdk",
  "version": "0.5.1",
  "description": "Zero-Knowledge Agent Handshake SDK for Midnight Blockchain",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zk-assets": "./src/generated/*"
  },
  "files": [
    "dist",
    "src/generated",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && ln -sfn ../src/generated dist/generated",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "^2.5.3",
    "@midnight-ntwrk/compact-runtime": "^0.15.0",
    "@midnight-ntwrk/midnight-js-contracts": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "^4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-types": "^4.1.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}