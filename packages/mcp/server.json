{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.rohan-protocol/mcp",
  "title": "Rohan Protocol MCP",
  "description": "Stateless zero-knowledge trust gateway and WebMCP shield for AI agents on Midnight.",
  "version": "0.7.0",
  "websiteUrl": "https://rohanprotocol.network",
  "repository": {
    "url": "https://github.com/rohan-protocol/sdk",
    "source": "github",
    "subfolder": "packages/mcp"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@rohan-protocol/mcp",
      "version": "0.7.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ROHAN_CONTRACT_ADDRESS",
          "description": "Midnight Preprod Contract Address for Rohan Trust Gateway",
          "default": "585ac0c4448257507d8ffa2a89e2aa00abd86ec9e94bdb6f553bc83e05f4dd0e",
          "isRequired": false,
          "format": "string"
        },
        {
          "name": "ROHAN_RELAYER_URL",
          "description": "Rohan Relayer API URL",
          "default": "https://api.rohanprotocol.network/api/v1/handshake",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ]
}
